{
	"compilerOptions": {
		"module": "nodenext",
		"target": "es2024",
		"lib": ["es2024", "dom"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"isolatedDeclarations": true,
		"declaration": true,
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": ["*.ts", "src", "test", "e2e"]
}
